# syntax=docker/dockerfile:1.4

# Build stage for example applications
FROM golang:1.23.0-alpine3.20 AS builder

WORKDIR /app

# Copy go mod and sum files first for better layer caching
COPY examples/go.mod examples/go.sum /app/examples/


# Copy example source code
COPY examples/ /app/examples/


# Download dependencies
WORKDIR /app/examples
RUN go mod download


# Build example applications
WORKDIR /app
RUN CGO_ENABLED=0 GOOS=linux go build -v -o /examples ./examples/...

# Final stage - minimal runtime image
FROM alpine:3.20

# Install CA certificates for HTTPS support
RUN apk add --no-cache ca-certificates

# Copy the compiled example binaries from the builder
COPY --from=builder /examples /usr/local/bin/

# Set environment variables
ENV ANTHROPIC_API_KEY=""
ENV GOPATH=/go
ENV PATH="$GOPATH/bin:$PATH"

# Default command - run basic example
CMD ["BasicUsage"]